# Frontend environment (Vite). Copy to .env.local for development; set the same names in Vercel → Settings → Environment Variables.
# Only VITE_* variables are exposed to the browser — never put secrets here.

# CHESS-IQ engine service (Play the Coach). Local default is http://localhost:8001 if unset in development.
VITE_ENGINE_API_URL=http://localhost:8001

# Main ChessIQ backend (profiles, puzzles, coach chat). Leave empty in dev to use the Vite proxy to localhost:8000.
VITE_API_BASE_URL=

# Supabase (Google sign-in)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=