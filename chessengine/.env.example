# Copy to chessengine/.env for local development (never commit .env).
# These are read by the engine API only. There are no secrets in this file.

# Runtime: auto (numpy if the .npz exists, else torch), numpy (no PyTorch needed), or torch (original evaluator).
ENGINE_RUNTIME=auto
# PyTorch-free weights made by `python -m api.export_numpy_weights`, and the original checkpoint (torch runtime only).
# Relative paths are resolved against chessengine/.
ENGINE_WEIGHTS_NPZ=checkpoints/model_d_square.npz
ENGINE_CHECKPOINT=checkpoints/model_d_square.pth

# Search depth: default 3, hard maximum 4 on a normal CPU. On Render's free plan (0.1 CPU) use 2 and 3.
# Depth 6 can take minutes per move in pure Python.
ENGINE_DEFAULT_DEPTH=3
ENGINE_MAX_DEPTH=4

# Searches that may run at once (CPU-bound, so keep 1 on small instances) and how many may wait.
ENGINE_MAX_CONCURRENT=1
ENGINE_MAX_QUEUE=8
ENGINE_REQUEST_TIMEOUT=120

# Requests per minute allowed from one IP address
ENGINE_RATE_LIMIT_PER_MIN=120

# PyTorch CPU threads (the network is tiny; 1 is fastest)
TORCH_NUM_THREADS=1

# Comma-separated browser origins allowed to call this API (your Vercel URL + local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: allow Vercel preview deployments
# CORS_ORIGIN_REGEX=https://chessiq-.*\.vercel\.app

LOG_LEVEL=INFO