# Copy to backend/.env — read by the BACKEND only. Never commit it, never expose these in the frontend.

# ── LLM providers (tried in LLM_PROVIDER_ORDER; if the first fails with a rate limit / timeout / 5xx the next is used)
LLM_PROVIDER_ORDER=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Stockfish (source of truth for all evaluations). apt install stockfish -> /usr/games/stockfish
STOCKFISH_PATH=stockfish
STOCKFISH_MOVETIME=0.8

# ── Supabase (Auth + Postgres)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only for projects still using the legacy HS256 JWT secret (Project Settings → API → JWT Secret).
# Leave empty on projects with asymmetric signing keys: tokens are then verified against SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
# Project Settings → Database → Connection string (use the "Session pooler" string if your network has no IPv6)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── Web
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=20